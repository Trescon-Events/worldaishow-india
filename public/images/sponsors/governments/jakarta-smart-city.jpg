		<script>
			$('#Subscribers-Form').submit(function(e) {
		   		e.preventDefault(); 
		  		var Event_Name = "World AI Show -23 - Dubai";
	    		var Subscriber_Email = $("#Subscriber_Email").val();
		  		$.ajax({
			    	type: "POST",
			    	url: "submit-subscribers.php",
			    	data: {'Event_Name': Event_Name, 'Subscriber_Email': Subscriber_Email},
			    	cache: false,
			    	beforeSend: function () { 
			      		$('#Subscribe-Sec').html('<center><img src="media/Spinner-1s-200px.gif" alt="" width="" height=""></center>');
			    	},
			    	success: function(html) {    
			      		$("#Subscribe-Sec").html(html);
			    	}
		  		});
			});
		</script>

			

		
		
