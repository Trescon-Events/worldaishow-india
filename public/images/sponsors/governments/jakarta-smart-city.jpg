		<script>
			$(window).scroll(function(){
			  	if ($(window).width() > 100) 
		  	{

			if ($(window).scrollTop() >= 70) {
			 	$('.T-Menu').addClass('fixed-header');
			}
			else {
			   	$('.T-Menu').removeClass('fixed-header');
			}
			  }
			});
		</script>
		<script>
			$(window).scroll(function() {
			    if ($(this).scrollTop() > 50 ) {
			        $('.scrolltop:hidden').stop(true, true).fadeIn();
			    } else {
			        $('.scrolltop').stop(true, true).fadeOut();
		    	}
			});
			$(function(){$(".scroll").click(function(){$("html,body").animate({scrollTop:$("body").offset().top},"7000");return false})})
		</script>

